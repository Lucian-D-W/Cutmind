{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutmind",
  "version": "1.1.0",
  "identifier": "com.cutbrain.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "calendar",
        "title": "Cutmind",
        "url": "/",
        "width": 1100,
        "height": 700,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Lucian W. (lucian-d-w)",
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (C) 2026 Lucian W. (lucian-d-w)",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE"
  }
}
